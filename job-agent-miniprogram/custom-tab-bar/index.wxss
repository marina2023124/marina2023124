.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 22rpx;
}

.tab-item.active {
  color: #4f46e5;
}

.tab-icon {
  font-size: 36rpx;
  line-height: 1.2;
}

.tab-text {
  margin-top: 4rpx;
}
