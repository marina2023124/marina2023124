page {
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.muted {
  color: #64748b;
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.btn-secondary {
  background: #f1f5f9;
  color: #334155;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #4f46e5;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #ecfdf5;
  color: #059669;
}

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
}
