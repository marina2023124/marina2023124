.page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.input,
.textarea {
  width: 100%;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 160rpx;
}

.work-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.work-title {
  font-weight: 600;
}

.work-item:last-child {
  border-bottom: none;
  margin-bottom: 16rpx;
}
