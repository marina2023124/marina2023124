<view class="page">
  <view class="card">
    <view class="card-title">岗位列表</view>
    <view class="muted">粘贴 JD 文字自动解析岗位信息</view>
    <button class="btn-primary add-btn" bindtap="addJob">+ 粘贴 JD 添加</button>
  </view>

  <view wx:if="{{jobs.length === 0}}" class="empty card">还没有岗位，点击上方添加</view>

  <view wx:for="{{jobs}}" wx:key="id" class="card job-card">
    <view class="job-head">
      <view>
        <view class="job-title">{{item.title}}</view>
        <view class="company">{{item.company}}</view>
      </view>
      <view class="badge">{{item.status || 'saved'}}</view>
    </view>
    <view class="muted job-meta">
      <text wx:if="{{item.location}}">{{item.location}}</text>
      <text wx:if="{{item.salary}}"> · {{item.salary}}</text>
    </view>
    <view class="job-desc">{{item.description}}</view>
    <button class="delete-btn" size="mini" data-id="{{item.id}}" bindtap="deleteJob">删除</button>
  </view>
</view>
