.page {
  padding: 24rpx;
}

.tabs {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  color: #64748b;
  font-size: 28rpx;
}

.tab.active {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-weight: 600;
}

.paste-btn {
  margin: 24rpx 0;
}

.method-title {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.guide-step {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.highlight {
  color: #4f46e5;
  font-weight: 600;
}

.tip {
  margin: 16rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.detect-btn {
  margin-bottom: 16rpx;
}

.jd-textarea {
  width: 100%;
  min-height: 400rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.url-input {
  width: 100%;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.field-input {
  width: 100%;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.req-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.half {
  flex: 1;
}
