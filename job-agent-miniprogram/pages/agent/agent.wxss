.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

.status-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #94a3b8;
}

.status-dot.on {
  background: #22c55e;
}

.status-text {
  font-size: 22rpx;
  color: #64748b;
}

.chat-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e0e7ff;
  color: #4f46e5;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-row.user .avatar {
  background: #dbeafe;
  color: #2563eb;
}

.bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.06);
}

.msg-row.user .bubble {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
}

.bubble.thinking {
  color: #94a3b8;
}

.quick-row {
  padding: 12rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
}

.quick-scroll {
  white-space: nowrap;
}

.quick-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  background: #f1f5f9;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475569;
}

.input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
}

.chat-input {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}

.send-btn {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  margin: 0;
}

.clear-btn {
  margin: 8rpx auto 16rpx;
  color: #94a3b8;
  background: transparent;
}
