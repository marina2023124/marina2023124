<view class="page">
  <view class="status-bar">
    <text class="status-dot {{llmReady ? 'on' : ''}}"></text>
    <text class="status-text">{{llmHint || '检测 DeepSeek 状态中...'}}</text>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="msg-row {{item.role}}">
      <view class="avatar">{{item.role === 'user' ? '我' : 'AI'}}</view>
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{thinking}}" class="msg-row assistant">
      <view class="avatar">AI</view>
      <view class="bubble thinking">DeepSeek 思考中...</view>
    </view>
    <view id="bottom"></view>
  </scroll-view>

  <view class="quick-row">
    <scroll-view scroll-x class="quick-scroll">
      <view
        wx:for="{{quickPrompts}}"
        wx:key="*this"
        class="quick-chip"
        data-text="{{item}}"
        bindtap="sendQuick"
      >{{item}}</view>
    </scroll-view>
  </view>

  <view class="input-bar">
    <input
      class="chat-input"
      placeholder="问职业顾问..."
      value="{{input}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="send"
    />
    <button class="send-btn" bindtap="send" disabled="{{thinking}}">发送</button>
  </view>

  <button class="clear-btn" bindtap="clearChat" size="mini">清空对话</button>
</view>
