.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748b;
}

.status-linked {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 26rpx;
}

.input {
  margin-top: 24rpx;
  height: 96rpx;
  border: 2rpx solid #c7d2fe;
  border-radius: 16rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  color: #4338ca;
}

.btn-primary {
  margin-top: 24rpx;
  background: #4f46e5;
  color: #fff;
  border-radius: 16rpx;
}

.btn-secondary {
  margin-top: 16rpx;
  background: #eef2ff;
  color: #4338ca;
  border-radius: 16rpx;
}

.tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.error {
  margin-top: 16rpx;
  color: #dc2626;
  font-size: 24rpx;
}
